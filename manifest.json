
{
  "manifest_version": 3,
  "name": "Urdu Translator",
  "version": "2.0.0",
  "description": "Translate webpage and PDF text into Urdu.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Urdu Translator",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
