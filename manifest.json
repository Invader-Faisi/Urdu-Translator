
{
  "manifest_version": 3,
  "name": "Urdu Translator",
  "version": "2.1.0",
  "description": "Translate selected webpage and PDF text into Urdu.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://api.mymemory.translated.net/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Click to enable or disable Urdu Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png"
    }
  },

  "commands": {
    "open-pdf-translator": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open Urdu PDF Translator"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "lib/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
